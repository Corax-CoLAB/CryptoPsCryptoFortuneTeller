# ==============================================================
# Crypto P's Fortune Teller - Environment Variables
# ==============================================================
# Note: Currently, the application accepts API credentials
# directly through the Streamlit UI. However, if you plan to
# customize the app to load secrets from the environment, you
# can use this file as a template.
# ==============================================================

# --------------------------------------------------------------
# 1. Exchange API Credentials (CCXT)
# --------------------------------------------------------------
# Supported Exchanges: Bitget, Gate.io, Bybit, OKX, KuCoin, Binance
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_exchange_api_key_here
EXCHANGE_API_SECRET=your_exchange_api_secret_here
# Passphrase required for some exchanges (e.g., OKX, KuCoin, Bitget)
EXCHANGE_API_PASSPHRASE=your_exchange_passphrase_here

# --------------------------------------------------------------
# 2. Freqtrade Bot Connectivity
# --------------------------------------------------------------
FREQTRADE_API_URL=http://127.0.0.1:8080
FREQTRADE_USERNAME=your_freqtrade_username
FREQTRADE_PASSWORD=your_freqtrade_password

# --------------------------------------------------------------
# 3. TensorFlow / System Settings
# --------------------------------------------------------------
# Suppress TensorFlow logging (0 = all, 1 = no INFO, 2 = no INFO/WARNING, 3 = no INFO/WARNING/ERROR)
TF_CPP_MIN_LOG_LEVEL=2

# --------------------------------------------------------------
# 4. Streamlit Configuration (Optional)
# --------------------------------------------------------------
# You can set Streamlit environment variables here as well.
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_HEADLESS=true
